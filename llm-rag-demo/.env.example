# At least one LLM provider key is required for /query endpoint
# The /health endpoint works without any keys

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# Provider order (comma-separated). First healthy provider is used.
# LLM_PROVIDER_ORDER=["openai","anthropic","openrouter"]

# Database (auto-configured by docker-compose)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ragdb
